# Copy to .env and fill in. Never commit .env.

# Optional: use an external LLM API instead of Ollama (config.yaml: llm.provider = "api").
# Retrieved passages leave your machine when this is used.
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MAX_TOKENS_PER_RUN=20000

# Telegram notifications (create a bot with BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email notifications (smtplib).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# Override the config file location (default: ./config.yaml).
# VAGALENS_CONFIG=config.yaml
